# Copy to .env and adjust. No real credentials are committed.
# On Linux set AIRFLOW_UID to your user id: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Project PostgreSQL (source database + Data Warehouse). Not Airflow's metadata DB.
# Host port for the project PostgreSQL (change it if 5433 is busy, e.g. 5434)
MUSIC_DB_HOST_PORT=5433
MUSIC_DB_USER=music_user
MUSIC_DB_PASSWORD=music_pass
MUSIC_DB_SOURCE_NAME=grammy_source
MUSIC_DB_DW_NAME=music_dw
